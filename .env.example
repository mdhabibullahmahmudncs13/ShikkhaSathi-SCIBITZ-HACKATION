# ShikkhaSathi Environment Configuration

# Backend Configuration
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=shikkhasathi
POSTGRES_PASSWORD=password
POSTGRES_DB=shikkhasathi
POSTGRES_PORT=5432

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=shikkhasathi

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI Services Configuration
OPENAI_API_KEY=your-openai-api-key-here
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=shikkhasathi-embeddings

# Voice Services Configuration
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Local AI Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8080

# Development Flags
DEVELOPMENT_MODE=true
USE_MOCK_DATABASES=false
USE_LOCAL_VOICE_SERVICES=true
VOICE_API_FALLBACK=false

# Frontend Environment Variables (for Vite)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8001
VITE_ENVIRONMENT=development